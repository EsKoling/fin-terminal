# ── Market data ────────────────────────────────────────────────────────────
# Binance / Coinbase / Kraken WebSockets and SEC EDGAR need NO key.

# https://finnhub.io/register            free: 60 calls/min
FINNHUB_API_KEY=

# https://twelvedata.com/pricing         free: 800 credits/day, 8/min  (reference data only - does NOT serve IDX quotes)
TWELVEDATA_API_KEY=

# https://fredaccount.stlouisfed.org/apikeys   free: 120 req/min
FRED_API_KEY=

# SEC requires a declared User-Agent with a real contact address.
SEC_USER_AGENT="fin-terminal/0.1 (you@example.com)"

# ── AI provider ladder ─────────────────────────────────────────────────────
# https://cloud.cerebras.ai     free: 1M tokens/day, 8192-token context cap
CEREBRAS_API_KEY=
# https://console.groq.com      free: 30 RPM, ~100K tokens/day
GROQ_API_KEY=
# https://aistudio.google.com   free: Flash-Lite 15 RPM / 500 RPD
GOOGLE_GENERATIVE_AI_API_KEY=

# ── Infrastructure ─────────────────────────────────────────────────────────
# https://console.upstash.com   free: 500K commands/month
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# https://console.neon.tech     free: 0.5 GB
DATABASE_URL=

# ── Runtime switches ───────────────────────────────────────────────────────
# live | cache-only  — cache-only keeps the app fully browsable with zero upstream calls.
FT_DATA_MODE=live
